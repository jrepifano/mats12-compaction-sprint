  "driver_source": "\"\"\"P47 power at larger counts (coordinator request, 2026-10-14). Uses design/power_sim.py.\"\"\"\nimport json, sys, time\nfrom pathlib import Path\nPROBE = Path(sys.argv[1]); sys.path.insert(0, str(PROBE / \"design\")); sys.path.insert(0, str(PROBE))\nimport power_sim as P\n\nMU, ST, SS, TALK, SEED = -1.5, 1.0, 1.0, 0.2, P.SEED\nNJ = int(sys.argv[2])\nsettings = [(84, 2, 6), (84, 4, 4), (45, 2, 6)]   # 45 last: its first run finished before the load kill\ngaps = [0.10, 0.15]\nt0 = time.time()\nrows = P.gap_grid(MU, ST, SS, n_large=200_000, seed=SEED)\ncal = P.pick_f(rows, 0.05)\nout = {\"params\": {\"mu\": MU, \"sigma_task\": ST, \"sigma_site\": SS, \"talk_rate\": TALK, \"seed\": SEED,\n                  \"power_datasets\": 100, \"power_boot\": 300, \"delta_datasets_005\": 2000,\n                  \"delta_datasets_other_gaps\": 500, \"n_jobs\": NJ},\n       \"note\": (\"delta_min fixed at the +0.05 planned-count value for each n \"\n                \"(nested leave-one-task-out, no bootstrap); power = share of c2 verdicts\"),\n       \"calibration_005\": cal, \"settings\": []}\nfor T, spt, d in settings:\n    counts = dict(tasks=T, sites_per_task=spt, draws=d, talk_rate=TALK)\n    ts = time.time()\n    dm = P.delta_min_planned(MU, ST, SS, cal[\"f\"], **counts, n_datasets=2000, seed=SEED + 4,\n                             n_jobs=NJ)\n    entry = {\"counts\": counts, \"delta_min_planned_005\": dm, \"gaps\": []}\n    for g in gaps:\n        c = P.pick_f(rows, g)\n        e = {\"target_gap\": g, \"f\": c[\"f\"], \"gap\": c[\"gap\"], \"auc_base\": c[\"auc_base\"],\n             \"auc_full\": c[\"auc_full\"], \"unattainable\": c[\"underpowered_by_construction\"]}\n        if not e[\"unattainable\"]:\n            e[\"delta_min_planned_at_gap\"] = P.delta_min_planned(\n                MU, ST, SS, c[\"f\"], **counts, n_datasets=500, seed=SEED + 4, n_jobs=NJ)\n            e[\"power\"] = P.power(MU, ST, SS, c[\"f\"], dm[\"delta_min\"], **counts,\n                                 n_datasets=100, n_boot=300, seed=SEED + 3, n_jobs=NJ)\n            sh = e[\"power\"][\"verdict_shares\"]\n            print(T, spt, d, g, {k: round(v, 3) for k, v in sh.items()},\n                  \"ci>0\", e[\"power\"][\"share_ci_low_above_0\"], flush=True)\n        entry[\"gaps\"].append(e)\n    entry[\"seconds\"] = time.time() - ts\n    out[\"settings\"].append(entry)\n    print(T, spt, d, \"dmin\", dm[\"delta_min\"], \"sec\", entry[\"seconds\"], flush=True)\n    out[\"driver_source\"] = Path(__file__).read_text()\n    (PROBE / \"design\" / \"power_sim_scale.json\").write_text(json.dumps(out, indent=2, default=float) + \"\\n\")\nout[\"seconds\"] = time.time() - t0\n(PROBE / \"design\" / \"power_sim_scale.json\").write_text(json.dumps(out, indent=2, default=float) + \"\\n\")\nprint(\"done\", out[\"seconds\"])\n",
  "seconds": 7385.406769990921
