.env
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.DS_Store
# large artifacts
*.pdf
data/raw/
results/**/activations/
*.safetensors
*.pt
*.npy
wandb/
# E1: large artifacts stay local; hashes live in committed manifests
data/E1/*.jsonl
results/E1/gen/
results/E1/judged/
results/E1/restore/
*.jsonl.zst
# held-out questions come from the encrypted EM dataset; hash is in data/E1/manifest.json
data/E1/questions/narrow.jsonl
# engine-check HF generations (large)
results/E1/gen_hf/
# hand-label key holds judge scores: never commit or open before Jacob finishes labelling
results/E1/validation/handlabel_key*.csv
# raw answers (some to held-out questions) from regenerations and failed-part staging; judged CSVs mirror them
results/E1/_regen_untrained_*/
results/E1/_staging_*/
results/E1/judged_hf/*.csv
results/E1/judged_restore/*.csv
# I1a: activations, raw samples and judge caches stay local; hashes live in committed manifests
results/I1a/acts/
results/I1a/samples/
results/I1a/topk/
results/I1a/judged/**/cells.jsonl
results/I1a/staging/
# vendored benchmark's own outputs, if its CLI is ever run inside the checkout
third_party/workspace-bench/outputs/
# other sessions' git worktrees
.claude/worktrees/
# third-party code cloned for reading/running; pinned commits are recorded in docs
third_party/
# SW-P0: raw Inspect logs, run stdout and extracted transcript snippets stay local
results/SW-P0/logs/
results/SW-P0/run_*.log
results/SW-P0/snippets.md
# raw codex transcripts from scripts/codex_review.sh (the review itself is the .md)
logs/reviews/*.log
# S4: raw logs, mock-walk logs, judge cache and the label key (never shown before labelling) stay local
results/S4/logs/
results/S4/mock_logs/
results/S4/judge_cache.jsonl
results/S4/label_bundle_key.csv
results/S4/judge_reservations.json
results/S4_mock_walk.log
results/S4/realism_bundle_*.csv
results/S4/label_bundle.csv
data/S4/awareness_concordance/judge_cache.jsonl
results/S4/*.log
*.pre-rebill
results/S4/label_bundle_contested.csv
results/S4/label_bundle_contested_key.csv
logs/judging.lock
# E1b: large or raw artifacts stay local; hashes live in committed manifests (plan §1.7)
