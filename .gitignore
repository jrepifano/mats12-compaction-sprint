.env
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.DS_Store
# large artifacts
*.pdf
data/raw/
results/**/activations/
*.safetensors
*.pt
*.npy
wandb/
# E1: large artifacts stay local; hashes live in committed manifests
data/E1/*.jsonl
results/E1/gen/
results/E1/judged/
results/E1/restore/
*.jsonl.zst
# held-out questions come from the encrypted EM dataset; hash is in data/E1/manifest.json
data/E1/questions/narrow.jsonl
# engine-check HF generations (large)
results/E1/gen_hf/
# hand-label key holds judge scores: never commit or open before Jacob finishes labelling
results/E1/validation/handlabel_key*.csv
# I1a: activations, raw samples and judge caches stay local; hashes live in committed manifests
results/I1a/acts/
results/I1a/samples/
results/I1a/topk/
results/I1a/judged/**/cells.jsonl
results/I1a/staging/
# vendored benchmark's own outputs, if its CLI is ever run inside the checkout
third_party/workspace-bench/outputs/
