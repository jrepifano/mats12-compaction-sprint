.env
.venv/
__pycache__/
*.pyc
.ruff_cache/
.pytest_cache/
.DS_Store
# large artifacts
*.pdf
data/raw/
results/**/activations/
*.safetensors
*.pt
*.npy
wandb/
# E1: large artifacts stay local; hashes live in committed manifests
data/E1/*.jsonl
results/E1/gen/
results/E1/judged/
results/E1/restore/
*.jsonl.zst
# held-out questions come from the encrypted EM dataset; hash is in data/E1/manifest.json
data/E1/questions/narrow.jsonl
# engine-check HF generations (large)
results/E1/gen_hf/
# hand-label key holds judge scores: never commit or open before Jacob finishes labelling
results/E1/validation/handlabel_key*.csv
# other sessions' git worktrees
.claude/worktrees/
# third-party code cloned for reading/running; pinned commits are recorded in docs
third_party/
# SW-P0: raw Inspect logs, run stdout and extracted transcript snippets stay local
results/SW-P0/logs/
results/SW-P0/run_*.log
results/SW-P0/snippets.md
